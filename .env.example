# Voice loop: "deepgram" (Deepgram Voice Agent: Flux + LLM + TTS in one) or "local" (Flux + Claude + Cartesia)
ENGINE=deepgram
DG_THINK_PROVIDER=anthropic
DG_THINK_MODEL=claude-haiku-4-5
# Voice: "cartesia" (uses CARTESIA_* below; Gemma) or "deepgram" (uses DG_VOICE)
DG_SPEAK_PROVIDER=cartesia
DG_VOICE=aura-2-pandora-en

# Needed for call summaries, and for the local engine
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
# Cartesia voice (Deepgram engine with DG_SPEAK_PROVIDER=cartesia, or the local engine)
CARTESIA_API_KEY=
# Pick a voice at https://play.cartesia.ai/voices and paste its ID
CARTESIA_VOICE_ID=

TELEGRAM_BOT_TOKEN=
# Only this chat ID can control the answering machine. Find it with: uv run --env-file .env -m answering_machine --telegram-whoami
TELEGRAM_CHAT_ID=

# Your name: the assistant only says it once a caller has (required)
OWNER_NAME=
# Comma-separated numbers that ring through unscreened (07…, +44… and 0044… all work)
ALLOWLIST=
# Seconds to let the phone ring before answering unknown callers
RING_DELAY=8
# Seconds to wait for your Telegram answer on an escalation before taking a message
ESCALATION_TIMEOUT=45

# Optional overrides
# ANTHROPIC_MODEL=claude-haiku-4-5
# SUMMARY_MODEL=claude-sonnet-5-5
# CARTESIA_MODEL=sonic-3.6
# MAX_CALL_SECONDS=300
